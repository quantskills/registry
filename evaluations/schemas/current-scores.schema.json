{
  "$defs": {
    "record": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^(?:skill|agent)-[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "category": {
          "pattern": "^[0-9]{2}$",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "featured": {
          "additionalProperties": false,
          "properties": {
            "affects_total": {
              "const": false
            },
            "material_core_regression_count": {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "score": {
              "maximum": 100,
              "minimum": 0,
              "type": [
                "number",
                "null"
              ]
            },
            "status": {
              "enum": [
                "eligible",
                "ineligible",
                "not_applicable"
              ]
            }
          },
          "required": [
            "status",
            "score",
            "reason",
            "affects_total",
            "material_core_regression_count"
          ],
          "type": "object"
        },
        "integrity": {
          "additionalProperties": false,
          "properties": {
            "attestation_key": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "attestation_key_id": {
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "attestation_payload_digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "measurement_digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "score_row_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "signed_envelope_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "measurement_digest",
            "attestation_key",
            "attestation_payload_digest",
            "attestation_key_id",
            "signed_envelope_sha256",
            "score_row_sha256"
          ],
          "type": "object"
        },
        "kind": {
          "enum": [
            "skill",
            "agent"
          ]
        },
        "metrics": {
          "additionalProperties": false,
          "properties": {
            "artifact_outcome": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "competition_eligible": {
              "type": "boolean"
            },
            "evaluation_tier": {
              "type": "string"
            },
            "reliability": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "trigger_f1": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "artifact_outcome",
            "competition_eligible",
            "evaluation_tier",
            "reliability",
            "trigger_f1"
          ],
          "type": "object"
        },
        "repo": {
          "pattern": "^quantskills/(?:skill|agent)-[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "schema": {
          "const": "quantskills.public-score-record.v2"
        },
        "score_comparability": {
          "pattern": "^publication\\.v12\\.[0-9]+-only$",
          "type": "string"
        },
        "score_formula": {
          "const": "score-formula.v9"
        },
        "score_key": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "scores": {
          "additionalProperties": false,
          "properties": {
            "behavior": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "quality": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "token": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "total": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "behavior",
            "quality",
            "token",
            "total"
          ],
          "type": "object"
        },
        "security": {
          "additionalProperties": false,
          "properties": {
            "evidence_digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "status": {
              "enum": [
                "pass",
                "pass_with_warning"
              ]
            }
          },
          "required": [
            "status",
            "evidence_digest"
          ],
          "type": "object"
        },
        "source_publication": {
          "enum": [
            "publication.v12.13",
            "publication.v12.14",
            "publication.v12.16",
            "publication.v12.20",
            "publication.v12.21",
            "publication.v12.22",
            "publication.v12.23",
            "publication.v12.13.on-demand"
          ]
        },
        "source_request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "usage": {
          "additionalProperties": false,
          "properties": {
            "core_model_calls": {
              "minimum": 0,
              "type": "integer"
            },
            "elapsed_ms": {
              "minimum": 0,
              "type": "integer"
            },
            "featured_model_calls": {
              "minimum": 0,
              "type": "integer"
            },
            "model_calls": {
              "minimum": 0,
              "type": "integer"
            },
            "recovery_model_calls": {
              "minimum": 0,
              "type": "integer"
            },
            "token_accounting": {
              "type": "string"
            },
            "total_tokens": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "model_calls",
            "core_model_calls",
            "featured_model_calls",
            "recovery_model_calls",
            "total_tokens",
            "elapsed_ms",
            "token_accounting"
          ],
          "type": "object"
        }
      },
      "required": [
        "schema",
        "asset_id",
        "kind",
        "category",
        "repo",
        "commit_sha",
        "source_publication",
        "source_request_id",
        "score_key",
        "score_formula",
        "score_comparability",
        "security",
        "scores",
        "featured",
        "metrics",
        "usage",
        "integrity"
      ],
      "type": "object"
    }
  },
  "$id": "https://quantskills.ai/schemas/public-score-dataset.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_snapshot_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "historical_observation_count": {
      "minimum": 1,
      "type": "integer"
    },
    "mode": {
      "const": "shadow"
    },
    "publication_precedence": {
      "items": {
        "type": "string"
      },
      "minItems": 7,
      "type": "array",
      "uniqueItems": true
    },
    "record_count": {
      "minimum": 1,
      "type": "integer"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "quantskills.public-score-dataset.v2"
    }
  },
  "required": [
    "schema",
    "generated_at",
    "mode",
    "record_count",
    "historical_observation_count",
    "catalog_snapshot_id",
    "publication_precedence",
    "records"
  ],
  "type": "object"
}
