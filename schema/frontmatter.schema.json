{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantskills.github.io/registry/schema/frontmatter.schema.json",
  "title": "QuantSkills asset declaration v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "quantSkills"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "description": {"type": "string", "minLength": 60},
    "license": {"const": "GPL-3.0-only"},
    "allowed-tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "user-invocable": {"type": "boolean"},
    "disable-model-invocation": {"type": "boolean"},
    "supported-runtimes": {"type": "array", "uniqueItems": true, "items": {"enum": ["cursor", "claude-code", "codex", "hermes", "openclaw"]}},
    "compatibility": {"type": "string", "maxLength": 500},
    "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "author": {"type": "string", "minLength": 1},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "organization": {"type": "string", "minLength": 1},
        "organization_url": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "repository_url": {"type": "string", "minLength": 1},
        "project_type": {"enum": ["skill", "agent"]},
        "collection": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "maintainer": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "compatible_agents": {"type": "array", "items": {"type": "string"}}
      }
    },
    "quantSkills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "organization", "organization_url", "repository",
        "repository_url", "project_type", "license", "maintainer", "catalog",
        "workflow", "summary_zh", "summary_en", "status", "validation_level",
        "maintainer_type", "platforms", "interface"
      ],
      "properties": {
        "schema_version": {"enum": ["2.0.0", "2.1.0"]},
        "organization": {"const": "quantskills"},
        "organization_url": {"const": "https://github.com/quantskills"},
        "repository": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "repository_url": {"type": "string"},
        "project_type": {"enum": ["skill", "agent"]},
        "license": {"const": "GPL-3.0-only"},
        "maintainer": {"type": "string", "minLength": 1},
        "collection": {"type": "string", "minLength": 1},
        "catalog": {"$ref": "#/$defs/catalog"},
        "workflow": {"$ref": "#/$defs/workflow"},
        "tags": {
          "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "requires": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:skill|agent)-[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "summary_zh": {"$ref": "#/$defs/summaryZh"},
        "summary_en": {"$ref": "#/$defs/summaryEn"},
        "status": {"enum": ["draft", "active", "stable", "deprecated"]},
        "validation_level": {"enum": ["listed", "runnable", "verified"]},
        "maintainer_type": {"enum": ["official", "community"]},
        "platforms": {
          "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
          "items": {"enum": ["cursor", "claude-code", "codex", "hermes", "openclaw"]},
          "allOf": [
            {"contains": {"const": "cursor"}},
            {"contains": {"const": "claude-code"}},
            {"contains": {"const": "codex"}},
            {"contains": {"const": "hermes"}},
            {"contains": {"const": "openclaw"}}
          ]
        },
        "interface": {
          "oneOf": [
            {"$ref": "#/$defs/structuredInterface"},
            {"$ref": "#/$defs/hybridInterface"},
            {"$ref": "#/$defs/naturalLanguageInterface"},
            {"$ref": "#/$defs/notApplicableInterface"}
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"quantSkills": {"properties": {"project_type": {"const": "agent"}}, "required": ["project_type"]}}, "required": ["quantSkills"]},
      "then": {"not": {"anyOf": [{"required": ["allowed-tools"]}, {"required": ["user-invocable"]}, {"required": ["disable-model-invocation"]}]}}
    }
  ],
  "$defs": {
    "exactSemver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "semverRange": {
      "type": "string",
      "description": "One or more space-separated exact semantic versions, optionally prefixed by >=, <=, >, <, ^, or ~.",
      "pattern": "^(?:(?:>=|<=|>|<|\\^|~)?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))(?: (?:>=|<=|>|<|\\^|~)?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))*$"
    },
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "subcategory"],
      "properties": {
        "category": {"enum": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10"]},
        "subcategory": {"type": "string", "pattern": "^(0[1-9]|10)\\.[a-z0-9][a-z0-9-]+$"}
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_stage", "workflow_stages"],
      "properties": {
        "primary_stage": {"$ref": "#/$defs/workflowStage"},
        "workflow_stages": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/workflowStage"}
        }
      }
    },
    "workflowStage": {
      "enum": ["data-ingestion", "data-quality", "feature-engineering", "factor-generation", "factor-screening", "modeling", "portfolio-construction", "backtesting", "evaluation", "risk", "monitoring", "execution", "reporting", "orchestration"]
    },
    "summaryZh": {
      "type": "string", "minLength": 8, "maxLength": 120,
      "pattern": "^(?!.*[\\r\\n])(?!.*\\[[^\\]]*\\]\\([^)]*\\)).+$"
    },
    "summaryEn": {
      "type": "string", "minLength": 8, "maxLength": 200,
      "pattern": "^(?!.*[\\r\\n])(?!.*\\[[^\\]]*\\]\\([^)]*\\)).+$"
    },
    "interfaceInput": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "version_range", "required"],
      "properties": {
        "profile": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "version_range": {"$ref": "#/$defs/semverRange"},
        "required": {"type": "boolean"}
      }
    },
    "interfaceOutput": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "version"],
      "properties": {
        "profile": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "version": {"$ref": "#/$defs/exactSemver"}
      }
    },
    "structuredInterface": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "envelope", "inputs", "outputs", "adapters"],
      "properties": {
        "mode": {"const": "structured"},
        "envelope": {"$ref": "#/$defs/envelope"},
        "inputs": {"$ref": "#/$defs/interfaceInputs"},
        "outputs": {"$ref": "#/$defs/interfaceOutputs"},
        "adapters": {"$ref": "#/$defs/adapters"}
      },
      "anyOf": [{"properties": {"inputs": {"minItems": 1}}}, {"properties": {"outputs": {"minItems": 1}}}]
    },
    "hybridInterface": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "envelope", "inputs", "outputs", "adapters"],
      "properties": {
        "mode": {"const": "hybrid"},
        "envelope": {"$ref": "#/$defs/envelope"},
        "inputs": {"$ref": "#/$defs/interfaceInputs"},
        "outputs": {"$ref": "#/$defs/interfaceOutputs"},
        "adapters": {"$ref": "#/$defs/adapters"}
      },
      "anyOf": [{"properties": {"inputs": {"minItems": 1}}}, {"properties": {"outputs": {"minItems": 1}}}]
    },
    "naturalLanguageInterface": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"const": "natural-language"}}
    },
    "notApplicableInterface": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": {"const": "not-applicable"},
        "reason": {"enum": ["natural-language-only", "report-only", "orchestration-only"]}
      }
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "quantskills-envelope"},
        "version": {"$ref": "#/$defs/exactSemver"}
      }
    },
    "interfaceInputs": {"type": "array", "items": {"$ref": "#/$defs/interfaceInput"}},
    "interfaceOutputs": {"type": "array", "items": {"$ref": "#/$defs/interfaceOutput"}},
    "adapters": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    }
  }
}
